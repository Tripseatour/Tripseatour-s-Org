{
  "rewrites": [
    {
      "source": "/api/livechat/sessions/:id",
      "destination": "/api/livechat?action=sessions&id=:id"
    },
    {
      "source": "/api/livechat/sessions",
      "destination": "/api/livechat?action=sessions"
    },
    {
      "source": "/api/livechat/send",
      "destination": "/api/livechat?action=send"
    },
    {
      "source": "/api/livechat/read/:id",
      "destination": "/api/livechat?action=read&id=:id"
    },
    {
      "source": "/api/livechat/delete/:id",
      "destination": "/api/livechat?action=delete&id=:id"
    },
    {
      "source": "/api/line-notify",
      "destination": "/api/send-line"
    },
    {
      "source": "/api/suppliers/save-all",
      "destination": "/api/suppliers?action=save-all"
    },
    {
      "source": "/api/suppliers/:id",
      "destination": "/api/suppliers?id=:id"
    },
    {
      "source": "/api/analytics/stats",
      "destination": "/api/analytics?action=stats"
    },
    {
      "source": "/api/analytics/ping",
      "destination": "/api/analytics?action=ping"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
